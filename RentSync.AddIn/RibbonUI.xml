<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui"
          onLoad="Ribbon_Load"
          loadImage="OnLoadImage">
  <ribbon>
    <tabs>
      <tab id="tabRentSync" label="RentSync Data">

        <!-- BRAND: the custom RentSync logo leads the tab, PRODA-style.
             image="logo32" is resolved by the OnLoadImage callback, which
             loads the embedded Assets/logo32.png. -->
        <group id="grpBrand" label="RentSync">
          <button id="btnBrand" label="Analytics" size="large"
                  image="logo32"
                  screentip="RentSync Analytics"
                  supertip="Independent portfolio demo - Excel VSTO add-in for commercial real-estate rent roll data."
                  onAction="OnRefreshClick" getEnabled="GetActionsEnabled"/>
        </group>

        <!-- DATA -->
        <group id="grpData" label="Data">
          <button id="btnRefresh" label="Refresh Data" size="large"
                  imageMso="RefreshAll"
                  screentip="Load rent roll (cache-first)"
                  supertip="Serves the local DuckDB cache when fresh; downloads from the API only when the cache is stale."
                  onAction="OnRefreshClick" getEnabled="GetActionsEnabled"/>
          <button id="btnForceRefresh" label="Force Download" size="large"
                  imageMso="ServerConnection"
                  screentip="Ignore cache and download now"
                  supertip="Bypasses the local cache and fetches a fresh snapshot from the API immediately."
                  onAction="OnForceRefreshClick" getEnabled="GetActionsEnabled"/>
        </group>

        <!-- ANALYTICS -->
        <group id="grpAnalytics" label="Analytics">
          <button id="btnSummary" label="Property&#10;Summary" size="large"
                  imageMso="TableInsert"
                  screentip="Aggregate rent, area and rate per property"
                  supertip="Groups the rent roll by property: unit count, total monthly rent, total area and average rent per square metre."
                  onAction="OnSummaryClick" getEnabled="GetActionsEnabled"/>
          <button id="btnExpiring" label="Expiring&#10;Leases" size="large"
                  imageMso="DateAndTimeInsert"
                  screentip="Leases expiring in the next 6 months"
                  supertip="Filters the rent roll to leases ending within six months of today."
                  onAction="OnExpiringClick" getEnabled="GetActionsEnabled"/>
        </group>

        <!-- SETUP -->
        <group id="grpSettings" label="Setup">
          <button id="btnSettings" label="Settings" size="large"
                  imageMso="ComAddInsDialog"
                  screentip="API token &amp; connection settings"
                  supertip="Stores the API token securely in Windows Credential Manager."
                  onAction="OnSettingsClick"/>
        </group>

      </tab>
    </tabs>
  </ribbon>
</customUI>
